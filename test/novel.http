# Novel Endpoints

# 1. Create a new novel
POST http://localhost:3000/api/novels
Content-Type: application/json 

{
    "title": "TGWOK",
    "chapter": "1",
    "page": "32"
}

###

# 1.1 Create a new novel with link
POST http://localhost:3000/api/novels
Content-Type: application/json

{
    "title": "TGWOK",
    "chapter": "1",
    "page": "32",
    "link": "https://example.com"
}

###

# 2. Get Novels
GET http://localhost:3000/api/novels

###

# 3. Get Novels by Title
GET http://localhost:3000/api/novels?q=Yolo

###

# 4. Update novel
PUT http://localhost:3000/api/novels/1
Content-Type: application/json

{
    "title": "RENAMED",
    "chapter": 2,
    "page": 3
}

###

# 4.1 Update novel with link
PUT http://localhost:3000/api/novels/1
Content-Type: application/json

{
    "title": "RENAMED",
    "chapter": 2,
    "page": 3,
    "link": "https://example.com"
}

###

# 5. Delete novel by id
DELETE http://localhost:3000/api/novels/1
